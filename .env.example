# Environment Configuration
# Copy this to .env and fill in your values

# === Polygon Mainnet Deployment ===
POLYGON_RPC=https://polygon-rpc.com
DEPLOYER_PK=0xYOUR_PRIVATE_KEY_HERE
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY_HERE

# === Mumbai Testnet (optional) ===
MUMBAI_RPC=https://rpc-mumbai.maticvigil.com

# === Unykorn L1 Production (when ready) ===
MAINNET_RPC_URL=https://rpc.unykorn.com
PRIVATE_KEY=0xYOUR_PRODUCTION_PRIVATE_KEY

# === Contract Constructor Args ===
TREASURY_ADDRESS=0xYOUR_TREASURY_ADDRESS
INITIAL_SUPPLY=100000000000000000000000000
MINT_PRICE=10000000000000000

# === Gas Reporting (optional) ===
REPORT_GAS=false
COINMARKETCAP_API_KEY=

# === Frontend ===
NEXT_PUBLIC_POLYGON_RPC=https://polygon-rpc.com
NEXT_PUBLIC_LAUNCH_VAULT_ADDRESS=
NEXT_PUBLIC_UNY_TOKEN_ADDRESS=
