{
  "name": "unykorn-l1",
  "version": "1.0.0",
  "description": "Unykorn L1 - Sovereign Layer-1 Blockchain (Chain ID 7777)",
  "main": "index.js",
  "scripts": {
    "test": "hardhat test",
    "compile": "hardhat compile",
    "preflight": "node scripts/preflight.js",
    "deploy:local": "hardhat run scripts/deploy.ts --network unykorn",
    "deploy:polygon": "hardhat run scripts/deploy-polygon.js --network polygon",
    "deploy:unyid:polygon": "hardhat run scripts/deploy-uny-id.js --network polygon",
    "deploy:energy:polygon": "hardhat run scripts/deploy-energy-system.js --network polygon",
    "deploy:energy:unykorn": "hardhat run scripts/deploy-energy-system.js --network unykorn",
    "deploy:mainnet": "hardhat run scripts/deploy.ts --network mainnet",
    "verify:polygon": "hardhat run scripts/verify-all.js --network polygon",
    "verify:all:polygon": "npm run verify:polygon && npm run verify:safes:polygon",
    "verify:safes:polygon": "hardhat run scripts/verify-safes.js --network polygon",
    "verify:safes:unykorn": "hardhat run scripts/verify-safes.js --network unykorn",
    "snapshot:polygon": "hardhat run scripts/snapshot.js --network polygon",
    "transfer:nft:polygon": "hardhat run scripts/transfer-nft-ownership.js --network polygon",
    "transfer:nft:unykorn": "hardhat run scripts/transfer-nft-ownership.js --network unykorn",
    "create:safes:polygon": "hardhat run scripts/create-production-safes.js --network polygon",
    "create:safes:unykorn": "hardhat run scripts/create-production-safes.js --network unykorn",
    "wire:safes:polygon": "hardhat run scripts/wire-ownerships-and-roles.js --network polygon",
    "wire:safes:unykorn": "hardhat run scripts/wire-ownerships-and-roles.js --network unykorn",
  "fund:unykorn": "hardhat run scripts/fund-account.js --network unykorn",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "verify": "hardhat verify"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "layer1",
    "besu",
    "qbft"
  ],
  "author": "Unykorn L1 Team",
  "license": "MIT",
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.3.11",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.6",
    "chai": "^4.3.10",
    "dotenv": "^17.2.3",
    "hardhat": "^2.19.4",
    "hardhat-gas-reporter": "^1.0.9",
    "solidity-coverage": "^0.8.5",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@layerzerolabs/solidity-examples": "^1.1.0",
    "@openzeppelin/contracts": "^5.0.1",
    "@safe-global/api-kit": "^4.0.0",
    "@safe-global/protocol-kit": "^6.1.1",
    "ethers": "^6.10.0"
  }
}
